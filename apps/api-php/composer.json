{
    "name": "devbuildsample/api-php",
    "description": "DevBuildSample 的 PHP 版 API（FrankenPHP）；composer 只用於單元測試，正式 image 沒有外部套件",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*"
    },
    "autoload": {
        "psr-4": {
            "Api\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    }
}
