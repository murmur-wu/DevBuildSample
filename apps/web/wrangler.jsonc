{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devbuildsample-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 只有 /api/* 先交給 Worker（代轉到後端），其他路徑直接回靜態檔案
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "vars": {
    // /api/node/*、/api/dotnet/*、/api/php/*、/api/py/* 要轉去的後端（含路徑前綴，與後端 compose 的 PATH_BASE 對應）
    // 本機開發用 .dev.vars 覆寫（見 .dev.vars.example）
    "NODE_API": "https://api-staging.heitang.info/node",
    "DOTNET_API": "https://api-staging.heitang.info/dotnet",
    "PHP_API": "https://api-staging.heitang.info/php",
    "PY_API": "https://api-staging.heitang.info/py"
  },
  "observability": {
    "enabled": true
  }
}
